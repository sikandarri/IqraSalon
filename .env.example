MONGODB_URI=mongodb://127.0.0.1:27017/iqra_signature
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
HOST=127.0.0.1
UPLOAD_DIR=./uploads
# For Vercel, set PUBLIC_ORIGIN to the exact deployed HTTPS origin.
# Vercel uses MongoDB GridFS for persistent media; UPLOAD_DIR is only for local Express.
SETUP_TOKEN=replace-with-a-long-random-token
AUTH_SECRET=replace-with-64-random-hex-characters
TRUST_PROXY=0
